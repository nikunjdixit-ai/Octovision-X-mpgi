# Copy this file to .env (never commit .env) and fill in your classroom camera.
# Used by: python scripts/run_attendance.py --source camera ...

# Option 1 - IP camera (Imou / Dahua): the script builds the RTSP URL from these
CAMERA_IP=192.168.1.50
CAMERA_USER=admin
CAMERA_PASSWORD=change-me
# 0 = main stream (full quality), 1 = sub stream (lower resolution, faster on a laptop)
CAMERA_SUBTYPE=0
# CAMERA_PORT=554
# CAMERA_CHANNEL=1

# Option 2 - any other camera: the full RTSP URL (used instead of the values above)
# CAMERA_RTSP_URL=rtsp://user:password@192.168.1.50:554/stream1
